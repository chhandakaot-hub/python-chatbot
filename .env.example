# Copy to .env and fill in your own values. .env is gitignored; this file is not.

APP_NAME=Python AI Bot

# The bot's own database. It creates its tables, but never the database itself.
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/python_ai_bot

# The assignment portal, read-only. The app refuses writes to it regardless,
# but use an account with SELECT only.
PORTAL_DATABASE_URL=mysql+pymysql://bot_readonly:password@127.0.0.1:3306/assignmentportaluat
# Seconds a portal query may run before the server stops it. 0 disables.
PORTAL_STATEMENT_TIMEOUT_SECONDS=15

GEMINI_API_KEY=your_api_key_here

# Auth -- generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never ship the placeholder: every token is signed with this.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI
AI_MODEL=gemini-flash-latest
AI_SYSTEM_PROMPT=You are a helpful assistant.
AI_TOOLS_ENABLED=true
AI_TEMPERATURE=0.7
# Gemini counts its thinking tokens against this, not just the visible answer.
AI_MAX_TOKENS=8192
# Seconds one Gemini call may take before it is abandoned (0 = no limit), and how
# many times a 5xx / 429 / timed-out call is retried, waiting 1s, 2s, ... between.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=1

DEBUG=false
